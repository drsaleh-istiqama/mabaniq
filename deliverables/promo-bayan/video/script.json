  "captions": {
    "n1": ["عميل يسأل: كم بقي من المكاتب المتاحة؟", "في التطوير العقاري، من يجيب أولًا يكسب الصفقة."],
    "n2": ["مع مبانيك، يردّ وكيل واتساب خلال ثوانٍ", "بالوحدات المتاحة فعلًا، ويحجز موعد المعاينة،", "ويسجّل العميل في سجل العملاء المحتملين."],
    "n3": ["في المقرّ، يرى العميل وحدته على المخطط الحقيقي،", "ويصدر له في الحال عرض سعر بترويسة بيان،", "وبخطة مرابحة واضحة."],
    "n4": ["وخلف ذلك بيانات مرتّبة: منسّق البيانات يرفع المخططات،", "ويعلّم مواقع الوحدات،", "وكل ملف يحمل بصمة تثبت أصالته."],
    "n5": ["وفي غرفة الاجتماعات، يجلس التخطيط والتسويق أمام الأرقام نفسها:", "أي الوحدات تُباع بسرعة، وأيها راكد.", "فيتفقان على السعر والحملة معًا."],
    "n6": ["والإيجار في مكان واحد: العقود والدفعات الربعية والمتأخرات،", "وتنبيه قبل انتهاء كل عقد."],
    "n7": ["ومن الموقع إلى المحاسبة: الإنجاز يُعتمد بالدليل،", "والتحصيل مرتبط بالعقد،", "والتأخر يصير تبرعًا لجهة خيرية، لا غرامة."],
    "n8": ["والمدير التنفيذي يفتح لوحة القيادة صباحًا،", "فيرى كل مشاريع الشركة في شاشة واحدة،", "والقرارات مرتبة بالأولوية والأثر المالي."],
    "n9": ["لكل شركة في المجموعة كيان معزول في قاعدة البيانات،", "وسجل تدقيق لا يُمحى،", "وكل مستند يُتحقق منه علنًا برمز مربّع."],
    "n10": ["مبانيك: من العرض إلى العقد إلى التسليم.", "جرّبوها على بيانات مشاريعكم."]
  }
}
