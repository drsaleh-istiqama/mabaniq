 "captions": {
  "n1": [
   "أبو سعيد عنده عقارات يأجّرها،",
   "وكل صباح يسأل: منو ساكن في أي وحدة؟",
   "وكم دفع؟ ومنو متأخّر؟ ووين الشيك؟"
  ],
  "n2": [
   "في قسم الإيجارات في مبانيك،",
   "كل هالأشياء تلقاها في شاشة وحدة:",
   "الإشغال، والمتأخرات، والعقود اللي قربت تخلص،",
   "والشيكات اللي جا وقت إيداعها."
  ],
  "n3": [
   "سالم، مدير الإيجارات، يختار وحدة فاضية ومستأجر مسجّل،",
   "ويشوف جدول الدفعات قبل ما يوقّع،",
   "بالزيادة السنوية وفترة التجهيز."
  ],
  "n4": [
   "ولين يوقّع العقد، الدفعات والتأمين تنطلع لحالها،",
   "وسالم يسلّم المفاتيح ليوسف،",
   "ويطلع محضر التسليم بقراءة العدّادات."
  ],
  "n5": [
   "يوسف يدفع بشيكات مؤجّلة. الشيك يُحفظ،",
   "وبعدين يتودّع، وبعدين ينصرف،",
   "وما يتحسب سداد إلا لين ينصرف.",
   "ولو ارتدّ الشيك، يرجع التحصيل ويبقى أثره باين."
  ],
  "n6": [
   "وكل دفعة لها إيصال مرقّم،",
   "ودفتر التحصيل ما ينمسح:",
   "لو صار غلط، يتصحّح بحركة عكسية، مب بحذف."
  ],
  "n7": [
   "ولو تأخّر مستأجر، النظام ينبّه المحصّل،",
   "وهو يصدر إنذار، أو يتفقون على خطة سداد",
   "توزّع الباقي نفسه من غير زيادة.",
   "وأي مبلغ يتحصّل عن التأخير تبرّع لجهة خيرية،",
   "مب فايدة ولا غرامة."
  ],
  "n8": [
   "ولو خرب المكيّف في محل يوسف،",
   "يتسجّل طلب الصيانة،",
   "ويصير أمر عمل بمورّد وتكلفة،",
   "وبعدين المصروف يتقيّد لحاله على اللي يتحمّله."
  ],
  "n9": [
   "وآخر الشهر يوصل أبو سعيد كشفه:",
   "كم تحصّل، وكم انصرف،",
   "وعمولة الإدارة، وكم صافي اللي يستحقه."
  ],
  "n10": [
   "وناصر المحاسب يشوف كل هذا يترحّل للدفاتر لحاله،",
   "وما في إدخال مرتين."
  ],
  "n11": [
   "ملف إيجار واحد تثق فيه،",
   "وكل رقم فيه من سجل حقيقي.",
   "مبانيك… عشان تأجّر بوضوح."
  ]
 }
}