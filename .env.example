# Copy to .env (never commit real values). Everything configurable lives here; the code has no other switches.

# --- Runtime ---------------------------------------------------------------
MABANIQ_ENV=demo                 # demo | prod  (prod refuses to start when any required value below is missing)
HOST=127.0.0.1
PORT=8800
MABANIQ_TRUST_PROXY=1            # trust cf-connecting-ip / x-forwarded-for only from the loopback proxy
MABANIQ_APP_NAME=مبانيك | Mabaniq
MABANIQ_APP_DOMAIN=mabaniq.example.org   # owner decision 4
MABANIQ_GIT_SHA=                 # injected by CI/Docker build

# --- Database --------------------------------------------------------------
# PostgreSQL with row-level security per developer organisation (Unit 1). Required in prod. Empty = SQLite files under data/ (development only).
MABANIQ_DATABASE_URL=
MABANIQ_DB=./data/mabaniq.db

# --- Secrets (prod: required; demo: generated once under data/secrets/ with mode 600) -----------------
MABANIQ_PII_KEY=                 # Fernet key — encrypts id numbers / dates of birth at rest
MABANIQ_PAY_SECRET=              # HMAC key of the payment-gateway webhook
MABANIQ_FORCE_PW_CHANGE=1
# Hosted demo only (MABANIQ_ENV=demo): one password for all demo accounts (admin, sales, finance, engineer, investor1,
# client1-4, broker1-2) — the container's data/ is ephemeral, so a generated credentials.json would not survive a redeploy.
MABANIQ_DEMO_PASSWORD=
# 0.13.0: developer organisations added by configuration (survive an ephemeral container): "code:display name;code2:name".
# A code with a profile in backend/tenant_profiles.py (e.g. almukhatat) is seeded from that profile; any other code gets the generic demo.
MABANIQ_TENANTS=
# 0.20.0 — ترخيص الوحدات لكل مطوّر: "code:bundle;code2:a+b+c" (bundle: leasing_only|develop_sell|develop_lease|enterprise). بلا قيمة = ما في ملف التعريف أو كل الوحدات
MABANIQ_LICENSES=
# 0.14.0 — temporary password (>= 12 chars) of the trial accounts a developer profile defines (e.g. almukhatat: dawood, mk-sales, ...);
# created at start-up, forced to change at first sign-in, never reset afterwards. Unset ⟵ no trial accounts.
MABANIQ_PILOT_PASSWORD=

# --- Abuse controls (requests per window) -----------------------------------
MABANIQ_RATE_LOGIN=10/60
MABANIQ_RATE_API=600/60
MABANIQ_RATE_WEBHOOK=60/60
MABANIQ_RATE_DEMO=5/3600            # 0.14.0: POST /api/public/demo-request (landing page) — own bucket per IP

# --- External identity (0.10.0) ---------------------------------------------
MABANIQ_PUBLIC_URL=              # absolute origin for e-mailed links and the Google redirect, e.g. https://mabaniq.om (required in prod when mail or Google is on)
MABANIQ_AUTH_SECRET=             # HMAC key of the OAuth state (prod: required; demo: generated under data/secrets/auth.key)
# Google sign-in (OpenID Connect). Create an OAuth client in Google Cloud Console → authorised redirect URI: <PUBLIC_URL>/auth/google/callback.
# Only EXISTING accounts can sign in: by linked Google id, or by a Google-verified e-mail equal to the account's e-mail. Hidden in the UI when unset.
MABANIQ_GOOGLE_CLIENT_ID=
MABANIQ_GOOGLE_CLIENT_SECRET=
# Outbound e-mail (recovery links, one-time sign-in links). Without a host: demo writes to data/outbox/ (tests read it), prod reports the feature unavailable.
MABANIQ_SMTP_HOST=
MABANIQ_SMTP_PORT=587
MABANIQ_SMTP_USER=
MABANIQ_SMTP_PASS=
MABANIQ_SMTP_FROM=               # e.g. no-reply@mabaniq.om
MABANIQ_SMTP_FROM_NAME=مبانيك
MABANIQ_SMTP_TLS=starttls        # starttls | ssl | none
MABANIQ_MAIL_ECHO=0              # demo only: return the e-mailed link in the API response (hosted demo without SMTP); ignored in prod

# --- Logging / monitoring ---------------------------------------------------
MABANIQ_LOG_JSON=1
MABANIQ_LOG_LEVEL=INFO
MABANIQ_SENTRY_DSN=              # optional error monitoring (no PII, no bodies, no cookies) — Unit 4
MABANIQ_METRICS_TOKEN=           # bearer token for GET /metrics (Prometheus text); empty = endpoint hidden (404)

# --- Operations (Unit 4) -----------------------------------------------------
MABANIQ_PG_POOL_MAX=10           # psycopg_pool connections per process (role + GUCs reset on every return)
MABANIQ_PG_POOL_TIMEOUT=10       # seconds to wait for a free connection
MABANIQ_CACHE_TTL=10             # seconds a dashboard computation (/api/decisions, /api/cash, /api/projects) is shared per developer; any write invalidates; 0 = off
WEB_CONCURRENCY=2                # uvicorn workers in the container (each has its own pool, rate buckets and cache)
MABANIQ_RETENTION=1              # scheduler in the API process (first pass 30 s after start, then every 15 min checks what is due)
MABANIQ_RETENTION_HOURS=24       # how often each developer organisation is processed
MABANIQ_RETENTION_LOGIN_DAYS=30          # login_attempts / auth_failures
MABANIQ_RETENTION_SESSIONS_DAYS=7        # expired sessions / reset tokens
MABANIQ_RETENTION_NOTIFICATIONS_DAYS=180
MABANIQ_RETENTION_PAY_INTENTS_DAYS=90    # pending → expired (kept)
MABANIQ_RETENTION_MESSAGES_DAYS=730      # WhatsApp phone masked to the last 4 digits
MABANIQ_RETENTION_DEMO_REQUESTS_DAYS=365 # 0.14.0: live-demo requests from the public landing page -> deleted

# --- Public landing page (0.14.0, docs/LANDING.md) -----------------------------
# Served on / (Arabic) and /en (English) to visitors; canonical, hreflang, Open Graph, JSON-LD, sitemap and robots all derive from MABANIQ_PUBLIC_URL.
MABANIQ_SALES_EMAIL=             # where live-demo requests are mailed (empty = the SMTP sender; demo without SMTP = data/outbox/)
MABANIQ_GSC_TOKEN=               # Google Search Console HTML-file verification: the token from google<token>.html (either form accepted) -> served on /google<token>.html
MABANIQ_BING_TOKEN=              # Bing Webmaster Tools: served on /BingSiteAuth.xml

# 0.18.0: optional LLM for the assistant (tool-use over read-only tools). Empty = the local rules engine only. The key lives ONLY here (never in the database);
# each organisation's admin still has to switch it on (Administration > Appearance & assistant). Customer names stay masked unless the admin allows them.
MABANIQ_AI_KEY=
MABANIQ_AI_MODEL=claude-sonnet-5-5
MABANIQ_AI_BASE=https://api.anthropic.com
